<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="16dp"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_performance"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            style="@style/GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView style="@style/StatLabel" android:text="CPU usage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <TextView android:id="@+id/perfCpuValue" android:textColor="@color/neon_blue" android:textStyle="bold" android:textSize="16sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—%" />
            </LinearLayout>

            <com.srtxcheats.iboostx.ui.LineGraphView
                android:id="@+id/cpuGraph"
                android:layout_width="match_parent"
                android:layout_height="120dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView style="@style/StatLabel" android:text="CPU temperature" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <TextView android:id="@+id/perfTempValue" android:textColor="@color/neon_purple" android:textStyle="bold" android:textSize="16sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—°C" />
            </LinearLayout>

            <com.srtxcheats.iboostx.ui.LineGraphView
                android:id="@+id/tempGraph"
                android:layout_width="match_parent"
                android:layout_height="120dp" />
        </LinearLayout>

        <LinearLayout
            style="@style/GlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView style="@style/StatLabel" android:text="Device" android:layout_marginBottom="10dp" />

            <TextView android:id="@+id/perfCoreCount" android:textColor="@color/text_primary" android:textSize="14sp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cores: —" android:layout_marginBottom="6dp" />
            <TextView android:id="@+id/perfRam" android:textColor="@color/text_primary" android:textSize="14sp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RAM: —" android:layout_marginBottom="6dp" />
            <TextView android:id="@+id/perfThermalApi" android:textColor="@color/text_primary" android:textSize="14sp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thermal API: —" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
