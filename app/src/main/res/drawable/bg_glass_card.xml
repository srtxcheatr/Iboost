<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- translucent fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- gloss highlight along the top edge, like light hitting glass -->
    <item android:top="0dp" android:bottom="60dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/glass_highlight"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- 1dp hairline stroke to sell the glass edge -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
            <corners android:radius="24dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
